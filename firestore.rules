rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // =========================
    // IDENTIDAD Y ROLES
    // =========================
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function em() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function dom() {
      return signedIn()
        && request.auth.token.email_verified == true
        && em().matches('.*@ibime[.]edu[.]mx');
    }

    function isAdminEmail() {
      return dom() && em() == 'josue.jain@ibime.edu.mx';
    }

    function hasProfile() {
      return dom()
        && exists(/databases/$(db)/documents/docentes/$(em()));
    }

    function profile() {
      return get(/databases/$(db)/documents/docentes/$(em())).data;
    }

    function admin() {
      return isAdminEmail()
        || (hasProfile() && profile().rol is string && profile().rol.lower() == 'admin');
    }

    function isDirectivo() {
      return hasProfile()
        && profile().rol is string
        && profile().rol.lower() == 'directivo';
    }

    function docente() {
      return hasProfile()
        && profile().rol is string
        && profile().rol.lower() in ['docente', 'admin'];
    }

    // Un privilegio solo habilita lectura al directivo.
    // Los directivos no tienen permisos de escritura en estas colecciones.
    function privilege(p) {
      return admin()
        || (isDirectivo()
          && profile().permisos is list
          && p in profile().permisos);
    }

    function ownDocente(id) {
      return dom() && em() == id.lower();
    }

    // Estos privilegios necesitan consultar el conjunto de datos que usa
    // el dashboard/panel para calcular cargas y registros.
    function canSeeGeneralData() {
      return privilege('dashboardGeneral')
        || privilege('docentes')
        || privilege('cargas')
        || privilege('avance');
    }

    // =========================
    // DOCENTES
    // =========================
    match /docentes/{id} {
      // Admin: acceso completo.
      // Directivo: lectura según sus privilegios.
      // Usuario: puede leer su propio perfil.
      allow read: if admin()
        || (isDirectivo() && canSeeGeneralData())
        || ownDocente(id);

      // Un docente/directivo no puede modificar perfiles ajenos.
      // El propio perfil solo puede ser creado/actualizado como docente.
      allow create: if admin()
        || (ownDocente(id)
          && request.resource.data.correo == em()
          && request.resource.data.rol is string
          && request.resource.data.rol.lower() == 'docente');

      allow update: if admin()
        || (ownDocente(id)
          && resource.data.rol is string
          && request.resource.data.rol is string
          && resource.data.rol.lower() == 'docente'
          && request.resource.data.rol.lower() == 'docente'
          && request.resource.data.correo == em());

      allow delete: if admin();
    }

    // =========================
    // GRUPOS
    // =========================
    match /grupos/{id} {
      allow read: if docente()
        || (isDirectivo() && (
          canSeeGeneralData() || privilege('grupos')
        ));
      allow write: if admin();
    }

    // =========================
    // ASIGNATURAS
    // =========================
    match /asignaturas/{id} {
      allow read: if docente()
        || (isDirectivo() && (
          canSeeGeneralData() || privilege('asignaturas')
        ));
      allow write: if admin();
    }

    // =========================
    // ALUMNOS
    // =========================
    match /alumnos/{id} {
      allow read: if docente()
        || (isDirectivo() && (
          canSeeGeneralData() || privilege('alumnos')
        ));

      allow create, update: if admin()
        || (
          docente()
          && request.resource.data.correo == id
          && request.resource.data.ultimoDocente == em()
        );

      allow delete: if admin();
    }

    // =========================
    // ASIGNACIONES
    // =========================
    match /asignaciones/{id} {
      allow read: if admin()
        || (isDirectivo() && (
          canSeeGeneralData() || privilege('asignaciones')
        ))
        || (docente() && resource.data.docente == em());

      allow create: if admin()
        || (docente() && request.resource.data.docente == em());

      allow update: if admin()
        || (
          docente()
          && resource.data.docente == em()
          && request.resource.data.docente == em()
        );

      allow delete: if admin()
        || (docente() && resource.data.docente == em());
    }

    // =========================
    // AVANCE
    // =========================
    match /avance/{id} {
      allow read: if admin()
        || (isDirectivo() && (
          canSeeGeneralData() || privilege('asignaciones')
        ))
        || (docente() && resource.data.docente == em());

      allow create: if admin()
        || (docente() && request.resource.data.docente == em());

      allow update: if admin()
        || (
          docente()
          && resource.data.docente == em()
          && request.resource.data.docente == em()
        );

      allow delete: if admin()
        || (docente() && resource.data.docente == em());
    }

    // =========================
    // CALIFICACIONES
    // =========================
    match /calificaciones/{id} {
      allow read: if admin()
        || (isDirectivo() && canSeeGeneralData())
        || (docente() && resource.data.docente == em());

      allow create: if admin()
        || (
          docente()
          && request.resource.data.docente == em()
          && request.resource.data.calif is number
          && request.resource.data.calif >= 0
          && request.resource.data.calif <= 10
        );

      allow update: if admin()
        || (
          docente()
          && resource.data.docente == em()
          && request.resource.data.docente == em()
          && request.resource.data.calif is number
          && request.resource.data.calif >= 0
          && request.resource.data.calif <= 10
        );

      allow delete: if admin();
    }
  }
}
