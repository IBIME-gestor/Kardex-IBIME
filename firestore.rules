rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function em() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }
    function dom() {
      return signedIn()
        && request.auth.token.email_verified == true
        && em().matches('.*@ibime[.]edu[.]mx');
    }
    function isAdminEmail() {
      return dom() && em() == 'josue.jain@ibime.edu.mx';
    }
    function hasProfile() {
      return dom() && exists(/databases/$(db)/documents/docentes/$(em()));
    }
    function profile() {
      return get(/databases/$(db)/documents/docentes/$(em())).data;
    }
    function admin() {
      return isAdminEmail() || (hasProfile() && profile().rol.lower() == 'admin');
    }
    function isDirectivo() {
      return hasProfile() && profile().rol.lower() == 'directivo';
    }
    function docente() {
      return hasProfile() && profile().rol.lower() in ['docente', 'admin'];
    }
    function privilege(p) {
      return admin() || (isDirectivo() && profile().permisos is list && p in profile().permisos);
    }
    function ownDocente(id) {
      return dom() && em() == id.lower();
    }

    match /docentes/{id} {
      allow read: if admin() || (isDirectivo() && (privilege('docentes') || privilege('dashboardGeneral') || privilege('avance'))) || ownDocente(id);
      allow create: if admin() || (ownDocente(id)
        && request.resource.data.correo == em()
        && request.resource.data.rol.lower() == 'docente');
      allow update: if admin() || (ownDocente(id)
        && resource.data.rol.lower() == 'docente'
        && request.resource.data.rol.lower() == 'docente'
        && request.resource.data.correo == em());
      allow delete: if admin();
    }

    match /grupos/{id} {
      allow read: if docente() || privilege('dashboardGeneral') || privilege('docentes') || privilege('grupos') || privilege('avance');
      allow write: if admin();
    }
    match /asignaturas/{id} {
      allow read: if docente() || privilege('dashboardGeneral') || privilege('docentes') || privilege('asignaturas');
      allow write: if admin();
    }
    match /alumnos/{id} {
      allow read: if docente() || privilege('dashboardGeneral') || privilege('docentes') || privilege('alumnos') || privilege('cargas') || privilege('avance');
      allow create, update: if admin() || (
        docente()
        && request.resource.data.correo == id
      );
      allow delete: if admin();
    }
    match /asignaciones/{id} {
      allow read: if admin() || privilege('dashboardGeneral') || privilege('docentes') || privilege('asignaciones') || privilege('cargas') || privilege('avance') || (docente() && resource.data.docente == em());
      allow create: if admin() || (docente() && request.resource.data.docente == em());
      allow update: if admin() || (docente() && resource.data.docente == em() && request.resource.data.docente == em());
      allow delete: if admin() || (docente() && resource.data.docente == em());
    }
    match /avance/{id} {
      allow read: if admin() || privilege('dashboardGeneral') || privilege('docentes') || privilege('avance') || privilege('cargas') || privilege('asignaciones') || (docente() && resource.data.docente == em());
      allow create: if admin() || (docente() && request.resource.data.docente == em());
      allow update: if admin() || (docente() && resource.data.docente == em() && request.resource.data.docente == em());
      allow delete: if admin() || (docente() && resource.data.docente == em());
    }
    match /calificaciones/{id} {
      allow read: if admin() || privilege('dashboardGeneral') || privilege('docentes') || privilege('avance') || privilege('cargas') || privilege('asignaciones') || (docente() && resource.data.docente == em());
      allow create: if admin() || (
        docente()
        && request.resource.data.docente == em()
        && request.resource.data.calif is number
        && request.resource.data.calif >= 0
        && request.resource.data.calif <= 10
      );
      allow update: if admin() || (
        docente()
        && resource.data.docente == em()
        && request.resource.data.docente == em()
        && request.resource.data.calif is number
        && request.resource.data.calif >= 0
        && request.resource.data.calif <= 10
      );
      allow delete: if admin();
    }
  }
}
