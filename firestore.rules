rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function em() { return signedIn() ? request.auth.token.email.lower() : ''; }
    function dom() { return signedIn() && em().matches('.*@ibime[.]edu[.]mx'); }
    function isAdminEmail() { return dom() && em() == 'josue.jain@ibime.edu.mx'; }
    function isStoredAdmin() {
      return dom() && exists(/databases/$(db)/documents/docentes/$(em()))
        && get(/databases/$(db)/documents/docentes/$(em())).data.rol == 'admin';
    }
    function admin() { return isAdminEmail() || isStoredAdmin(); }
    function docente() {
      return dom() && exists(/databases/$(db)/documents/docentes/$(em()))
        && get(/databases/$(db)/documents/docentes/$(em())).data.rol in ['docente', 'admin'];
    }
    function ownDocente(id) { return dom() && em() == id; }

    match /docentes/{id} {
      // El admin puede administrar completamente esta colección.
      allow read, write: if admin();
      allow get: if ownDocente(id);
      // Alta automática de un usuario nuevo: solo puede crearse a sí mismo como docente.
      allow create: if ownDocente(id)
        && request.resource.data.rol == 'docente'
        && request.resource.data.correo == id;
      // Un docente no puede modificar su rol ni convertir su cuenta en admin.
      allow update: if ownDocente(id)
        && resource.data.rol == 'docente'
        && request.resource.data.rol == 'docente'
        && request.resource.data.correo == id;
      allow delete: if admin();
    }

    match /grupos/{id} {
      allow read: if docente() || admin();
      allow write: if admin();
    }
    match /asignaturas/{id} {
      allow read: if docente() || admin();
      allow write: if admin();
    }
    match /alumnos/{id} {
      allow read: if docente() || admin();
      allow write: if admin();
    }

    match /asignaciones/{id} {
      allow read: if admin() || (docente() && resource.data.docente == em());
      allow create: if admin() || (docente() && request.resource.data.docente == em());
      allow update: if admin() || (docente() && resource.data.docente == em() && request.resource.data.docente == em());
      allow delete: if admin() || (docente() && resource.data.docente == em());
    }

    match /calificaciones/{id} {
      allow read: if admin() || (docente() && resource.data.docente == em());
      allow create, update: if admin() || (
        docente() && request.resource.data.docente == em()
        && request.resource.data.calif is number
        && request.resource.data.calif >= 0
        && request.resource.data.calif <= 10
      );
      allow delete: if admin();
    }

    match /avance/{id} {
      allow read: if admin() || (docente() && resource.data.docente == em());
      allow create, update: if admin() || (docente() && request.resource.data.docente == em());
      allow delete: if admin() || (docente() && resource.data.docente == em());
    }
  }
}
